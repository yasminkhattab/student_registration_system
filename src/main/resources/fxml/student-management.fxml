<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studentregistration.controller.StudentManagementController">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="16">
            <ImageView fitHeight="34" fitWidth="34" preserveRatio="true">
                <image>
                    <Image url="@../images/university-mark.png"/>
                </image>
            </ImageView>
            <VBox spacing="2">
                <Label text="Student management" styleClass="app-title"/>
                <Label text="Add, edit, delete and search student records" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#handleBack" styleClass="btn-ghost"/>
        </HBox>
    </top>

    <center>
        <HBox styleClass="page" spacing="18">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Search by ID, name, email or major"
                               HBox.hgrow="ALWAYS" onAction="#handleSearch" prefHeight="36"/>
                    <Button text="Search" onAction="#handleSearch" styleClass="btn-secondary"/>
                    <Button text="Clear" onAction="#handleClearSearch" styleClass="btn-ghost"/>
                </HBox>
                <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="100"/>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"/>
                        <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                        <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="130"/>
                        <TableColumn fx:id="majorColumn" text="Major" prefWidth="170"/>
                        <TableColumn fx:id="levelColumn" text="Level" prefWidth="70"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox styleClass="card form-card" spacing="8" prefWidth="340" minWidth="320">
                <Label fx:id="formTitleLabel" text="Add a new student" styleClass="section-title"/>

                <Label text="Student ID" styleClass="field-label"/>
                <TextField fx:id="idField" promptText="STU-1004"/>

                <Label text="Full name" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="Noura Al-Saud"/>

                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="name@taibah.edu.sa"/>

                <Label text="Phone" styleClass="field-label"/>
                <TextField fx:id="phoneField" promptText="0501234567"/>

                <Label text="Major" styleClass="field-label"/>
                <TextField fx:id="majorField" promptText="Computer Science"/>

                <Label text="Level (1-8)" styleClass="field-label"/>
                <TextField fx:id="levelField" promptText="1"/>

                <Label fx:id="messageLabel" styleClass="status-label" wrapText="true" minHeight="34"/>

                <HBox spacing="8">
                    <Button fx:id="addButton" text="Add" onAction="#handleAdd"
                            styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="updateButton" text="Update" onAction="#handleUpdate"
                            styleClass="btn-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="8">
                    <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
                            styleClass="btn-danger" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="Clear" onAction="#handleClear"
                            styleClass="btn-ghost" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
