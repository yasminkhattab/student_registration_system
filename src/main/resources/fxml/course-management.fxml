<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studentregistration.controller.CourseManagementController">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="16">
            <ImageView fitHeight="34" fitWidth="34" preserveRatio="true">
                <image>
                    <Image url="@../images/university-mark.png"/>
                </image>
            </ImageView>
            <VBox spacing="2">
                <Label text="Course management" styleClass="app-title"/>
                <Label text="Maintain the catalogue and review enrollments" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#handleBack" styleClass="btn-ghost"/>
        </HBox>
    </top>

    <center>
        <HBox styleClass="page" spacing="18">
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Search by ID, title or instructor"
                               HBox.hgrow="ALWAYS" onAction="#handleSearch" prefHeight="36"/>
                    <Button text="Search" onAction="#handleSearch" styleClass="btn-secondary"/>
                    <Button text="Clear" onAction="#handleClearSearch" styleClass="btn-ghost"/>
                </HBox>

                <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                    <TableView fx:id="courseTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="titleColumn" text="Title" prefWidth="190"/>
                            <TableColumn fx:id="creditsColumn" text="Credits" prefWidth="70"/>
                            <TableColumn fx:id="instructorColumn" text="Instructor" prefWidth="160"/>
                            <TableColumn fx:id="scheduleColumn" text="Schedule" prefWidth="150"/>
                            <TableColumn fx:id="enrolledColumn" text="Enrolled" prefWidth="80"/>
                            <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox styleClass="card" spacing="8" prefHeight="215" minHeight="180">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="enrollmentCourseLabel" text="Select a course to see its enrolled students."
                               styleClass="section-title-small"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="dropEnrollmentButton" text="Drop selected student"
                                onAction="#handleDropEnrollment" styleClass="btn-danger-small"
                                disable="true"/>
                    </HBox>
                    <TableView fx:id="enrollmentTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="studentIdColumn" text="Student ID" prefWidth="110"/>
                            <TableColumn fx:id="studentNameColumn" text="Name" prefWidth="220"/>
                            <TableColumn fx:id="studentMajorColumn" text="Major" prefWidth="200"/>
                            <TableColumn fx:id="studentLevelColumn" text="Level" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <VBox styleClass="card form-card" spacing="8" prefWidth="320" minWidth="300">
                <Label fx:id="formTitleLabel" text="Add a new course" styleClass="section-title"/>

                <Label text="Course ID" styleClass="field-label"/>
                <TextField fx:id="courseIdField" promptText="CS220"/>

                <Label text="Title" styleClass="field-label"/>
                <TextField fx:id="titleField" promptText="Algorithms"/>

                <Label text="Credit hours (1-6)" styleClass="field-label"/>
                <TextField fx:id="creditsField" promptText="3"/>

                <Label text="Capacity (1-500)" styleClass="field-label"/>
                <TextField fx:id="capacityField" promptText="30"/>

                <Label text="Instructor" styleClass="field-label"/>
                <TextField fx:id="instructorField" promptText="Dr. ..."/>

                <Label text="Schedule" styleClass="field-label"/>
                <TextField fx:id="scheduleField" promptText="Sun/Tue 10:00-11:30"/>

                <Label fx:id="messageLabel" styleClass="status-label" wrapText="true" minHeight="34"/>

                <HBox spacing="8">
                    <Button fx:id="addButton" text="Add" onAction="#handleAdd"
                            styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="updateButton" text="Update" onAction="#handleUpdate"
                            styleClass="btn-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="8">
                    <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
                            styleClass="btn-danger" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="Clear" onAction="#handleClear"
                            styleClass="btn-ghost" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
