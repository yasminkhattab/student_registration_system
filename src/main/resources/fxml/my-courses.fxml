<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studentregistration.controller.MyCoursesController">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="16">
            <ImageView fitHeight="34" fitWidth="34" preserveRatio="true">
                <image>
                    <Image url="@../images/university-mark.png"/>
                </image>
            </ImageView>
            <VBox spacing="2">
                <Label text="My registered courses" styleClass="app-title"/>
                <Label text="Review and drop your current enrollments" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to dashboard" onAction="#handleBack" styleClass="btn-ghost"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page" spacing="14">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
                <Label text="Total registered credit hours" styleClass="info-key"/>
                <Label fx:id="totalCreditsLabel" text="0" styleClass="stat-value-small"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-ghost"/>
            </HBox>

            <TableView fx:id="courseTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="courseIdColumn" text="Course ID" prefWidth="110"/>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="280"/>
                    <TableColumn fx:id="creditsColumn" text="Credits" prefWidth="80"/>
                    <TableColumn fx:id="instructorColumn" text="Instructor" prefWidth="200"/>
                    <TableColumn fx:id="scheduleColumn" text="Schedule" prefWidth="180"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="dropButton" text="Drop selected course" onAction="#handleDrop"
                        styleClass="btn-danger"/>
                <Button text="Browse courses" onAction="#handleBrowseCourses" styleClass="btn-secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="messageLabel" styleClass="status-label" wrapText="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
