<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studentregistration.controller.StudentDashboardController">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="16">
            <ImageView fitHeight="34" fitWidth="34" preserveRatio="true">
                <image>
                    <Image url="@../images/university-mark.png"/>
                </image>
            </ImageView>
            <VBox spacing="2">
                <Label fx:id="welcomeLabel" text="Welcome!" styleClass="app-title"/>
                <Label text="Student dashboard · Personal information and current registrations"
                       styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Sign out" onAction="#handleLogout" styleClass="btn-ghost"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page" spacing="18">
            <HBox spacing="16">
                <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="Personal information" styleClass="section-title"/>
                    <HBox spacing="8">
                        <Label text="Student ID" styleClass="info-key" prefWidth="110"/>
                        <Label fx:id="studentIdLabel" styleClass="info-value"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Full name" styleClass="info-key" prefWidth="110"/>
                        <Label fx:id="studentNameLabel" styleClass="info-value"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Email" styleClass="info-key" prefWidth="110"/>
                        <Label fx:id="emailLabel" styleClass="info-value"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Phone" styleClass="info-key" prefWidth="110"/>
                        <Label fx:id="phoneLabel" styleClass="info-value"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Major" styleClass="info-key" prefWidth="110"/>
                        <Label fx:id="majorLabel" styleClass="info-value"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Level" styleClass="info-key" prefWidth="110"/>
                        <Label fx:id="levelLabel" styleClass="info-value"/>
                    </HBox>
                </VBox>

                <VBox styleClass="card" spacing="12" prefWidth="270" minWidth="240">
                    <Label text="This semester" styleClass="section-title"/>
                    <VBox styleClass="stat-card" spacing="4">
                        <Label text="ENROLLED COURSES" styleClass="stat-caption"/>
                        <Label fx:id="enrolledCountLabel" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="4">
                        <Label text="TOTAL CREDIT HOURS" styleClass="stat-caption"/>
                        <Label fx:id="creditTotalLabel" text="0" styleClass="stat-value"/>
                    </VBox>
                </VBox>
            </HBox>

            <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Current registrations" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-ghost"/>
                    <Button text="Browse courses" onAction="#handleBrowseCourses" styleClass="btn-primary"/>
                    <Button text="My courses" onAction="#handleMyCourses" styleClass="btn-secondary"/>
                </HBox>
                <TableView fx:id="coursesTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="courseIdColumn" text="Course ID" prefWidth="110"/>
                        <TableColumn fx:id="titleColumn" text="Title" prefWidth="240"/>
                        <TableColumn fx:id="creditsColumn" text="Credits" prefWidth="80"/>
                        <TableColumn fx:id="instructorColumn" text="Instructor" prefWidth="190"/>
                        <TableColumn fx:id="scheduleColumn" text="Schedule" prefWidth="170"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
